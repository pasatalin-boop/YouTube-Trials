{
  "name": "youtube-trials",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Server-side fal.ai image-to-video generation pipeline for YouTube content workflows",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "check": "node --check src/server.js && node --check scripts/e2e-test.js",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e-test.js"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0"
  }
}