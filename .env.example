# Required: create an API key in your fal.ai account. Keep this file private.
FAL_KEY=

# Both model IDs must be present in this comma-separated allowlist.
FAL_ALLOWED_ENDPOINTS=fal-ai/flux/schnell,fal-ai/wan-i2v

# Default models used by the automated image-to-video pipeline.
PIPELINE_IMAGE_ENDPOINT=fal-ai/flux/schnell
PIPELINE_VIDEO_ENDPOINT=fal-ai/wan-i2v

PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
