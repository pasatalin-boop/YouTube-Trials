# Required: create an API key in your fal.ai account.
FAL_KEY=

# Comma-separated fal model endpoint IDs permitted by this server.
# Example: fal-ai/flux/schnell, fal-ai/kling-video/v2.1/standard
FAL_ALLOWED_ENDPOINTS=

# HTTP server settings
PORT=3000
# Set to your exact frontend origin in deployment, e.g. https://app.example.com
ALLOWED_ORIGIN=http://localhost:5173
